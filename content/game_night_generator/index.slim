---
title: Game Night Generator
---

doctype html
html[lang="en"]
  head
    meta[charset="UTF-8"]
    meta[content="IE=edge" http-equiv="X-UA-Compatible"]
    meta[content="width=device-width, initial-scale=1.0" name="viewport"]
    link[href="/game_night_generator/css/application.css" rel="stylesheet"]
    script[src="/game_night_generator/js/application.js"]
  body
    .container.m3.flex-row.flex-mobile-column.height-full.box-shadowify
      #image_preview.flex-grow
      #menu.flex-column.height-full
        h1.center
          | W3D Hub Game Night Banner Generator
        .flex-row.m1
          label.width-50[for="template"]
            | Template
          select#template.flex-grow[choose="APB" name="template"]
            option[value="APB"]
              | APB - A Path Beyond
            option[value="AR"]
              | AR - Apocalypse Rising
            option[value="BFD"]
              | BFD - Battle for Dune
            option[value="CWC"]
              | CWC - Cold War Confrontation
            option[value="ECW"]
              | ECW - Expansive Civilian Warfare
            option[value="GZ"]
              | GZ - Ground Zero
            option[value="IA"]
              | IA - Interim Apex
            option[value="TSR"]
              | TSR - Tiberian Sun: Reborn
            option[value="REN"]
              | REN - Renegade

        .flex-row.m1
          label.width-50[for="color"]
            | Text Color
          input#color.flex-grow[name="color" type="color" value="#ffffff"]

        .flex-row.m1
          label.width-50[for="outline_color"]
            | Text Outline Color
          input#outline_color.flex-grow[name="outline_color" type="color" value="#aaaaaa"]

        .flex-row.m1
          label.width-50[for="date"]
            | GMT Date
          input#date.flex-grow[name="date" type="date"]

        .flex-row.m1
          label.width-50[for="time"]
            | GMT Time
          input#time.flex-grow[name="time" type="time"]

        .flex-row.m1
          label.width-50[for="backdrop"]
            | Backdrop
          input#backdrop.flex-grow[accept="image/*" name="backdrop" type="file"]

        .flex-row.m1
          label.width-50[for="prefab_backdrop"]
            | Prefab Backdrop
          select#prefab_backdrop.flex-grow[name="prefab_backdrop"]
            option[value=""]
              | --none--
            hr
            optgroup[label="A Path Beyond"]
              option[value="apb_banner"]
                | APB Mammoth and Longbow
              option[value="apb_background"]
                | APB Map
              option[value="apb_thief"]
                | APB Sneaky Thief
              option[value="apb_allied_cruiser"]
                | APB Cruiser
              option[value="apb_missile_submarine"]
                | APB Missile Submarine
            hr
            optgroup[label="Apocalypse Rising"]
              option[value="ar_banner"]
                | AR - Prism Tanks
              option[value="ar_allied_ore_miner"]
                | AR - Allied Ore Miner
              option[value="ar_doggo"]
                | AR - Office Doggo
              option[value="ar_gi"]
                | AR - Dune Patrol GIs
              option[value="ar_kirovs"]
                | AR - Fort Bradley Kirovs
              option[value="ar_soviet_war_factory"]
                | AR - Soviet War Factory
            hr
            optgroup[label="Battle for Dune"]
              option[value="woa_banner"]
                | BFD - Move to Point B
              option[value="woa_background"]
                | BFD - Rock Textures
            hr
            optgroup[label="Cold Ware Confrontation"]
              option[value="cwc_banner"]
                | CWC - banner
            hr
            optgroup[label="Expansive Civilian Warfare"]
              option[value="ecw_banner"]
                | ECW - Fountain
              option[value="ecw_cabin"]
                | ECW - Cabin
              option[value="ecw_city"]
                | ECW - City
              option[value="ecw_city2"]
                | ECW - City2
              option[value="ecw_sunset"]
                | ECW - Sunset
            hr
            optgroup[label="Ground Zero"]
              option[value="gz_banner"]
                | GZ - Hand of Nod
            hr
            optgroup[label="Interim Apex"]
              option[value="ia_banner"]
                | IA - Bradley
              option[value="ia_assault"]
                | IA - Assault
              option[value="ia_crane"]
                | IA - Crane
              option[value="ia_ezekiel"]
                | IA - Ezekiel
              option[value="ia_power_plant"]
                | IA - Power Plant
              option[value="ia_radio_tower"]
                | IA - Radio Tower
              option[value="ia_ships"]
                | IA - Ships
            hr
            optgroup[label="Reborn"]
              option[value="tsr_banner"]
                | TSR - Ambient Green Titan
              option[value="tsr_banshee"]
                | TSR - Banshee
              option[value="tsr_mammoth_mk2"]
                | TSR - Mammoth MKII
              option[value="tsr_orca"]
                | TSR - Orca
              option[value="tsr_reaper"]
                | TSR - Reaper
              option[value="tsr_titan"]
                | TSR - Titan
            hr
            optgroup[label="Renegade"]
              option[value="ren_banner"]
                | REN - Havoc infront of Mammoth
              option[value="ren_flamer_rush"]
                | REN - Flame Tank Rush
              option[value="ren_mesa"]
                | REN - Mesa Cave
              option[value="ren_mobius_patrol"]
                | REN - Mobius on Patrol
              option[value="ren_stank_rush"]
                | REN - Stealth Tank Rush

        .flex-grow

        a#save.save-button.m3
          | Save
